# LLM provider: any server that implements the OpenAI Chat Completions API with tool calling.
# Copy this file to .env (never commit .env). Variables already set in the shell take precedence.

# --- Option A: OpenAI (hosted) ---------------------------------------------------------
# LLM_BASE_URL defaults to https://api.openai.com/v1 when omitted.
LLM_API_KEY=
LLM_MODEL=
# Optional. Leave unset for models that only accept the default temperature.
# LLM_TEMPERATURE=0.1

# --- Option B: Ollama (local) ------------------------------------------------------------
# Use a model with tool-calling support (check `ollama show <model>`), e.g. after `ollama pull <model>`.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<model name as shown by `ollama list`>
# LLM_TEMPERATURE=0.1
# (LLM_API_KEY is not needed for localhost URLs.)

# --- Optional tuning ---------------------------------------------------------------------
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# AGENT_MAX_TOOL_ROUNDS=6
# AGENT_MAX_VALIDATION_RETRIES=1
# AGENT_MAX_HISTORY_MESSAGES=12
# RAG_TOP_K=4
# RAG_MIN_SCORE=0.20
